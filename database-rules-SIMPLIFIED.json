{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null",
        "participants": {
          "$userId": {
            ".write": "auth.uid === $userId || root.child('admins').child(auth.uid).val() === true"
          }
        },
        "scores": {
          "$userId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },
    "posts": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
