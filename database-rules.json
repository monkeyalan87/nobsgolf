{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'email', 'handicap', 'joinedDate'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "handicap": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 54"
        },
        "eventsPlayed": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "leaguePoints": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'venue', 'date', 'time', 'cost', 'maxPlayers', 'countsForLeague', 'createdBy', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "venue": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "date": {
          ".validate": "newData.isString()"
        },
        "time": {
          ".validate": "newData.isString()"
        },
        "cost": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "countsForLeague": {
          ".validate": "newData.isBoolean()"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "participants": {
          "$userId": {
            ".write": "auth.uid === $userId || data.exists()",
            "joinedAt": {
              ".validate": "newData.isString()"
            },
            "paid": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "scores": {
          "$userId": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },
    "posts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$postId": {
        ".validate": "newData.hasChildren(['authorId', 'authorName', 'timestamp'])",
        "authorId": {
          ".validate": "newData.isString()"
        },
        "authorName": {
          ".validate": "newData.isString()"
        },
        "content": {
          ".validate": "newData.isString()"
        },
        "photoData": {
          ".validate": "newData.isString()"
        },
        "hasPhoto": {
          ".validate": "newData.isBoolean()"
        },
        "type": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.isString()"
        },
        "likes": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "likedBy": {
          "$userId": {
            ".write": "auth.uid === $userId",
            ".validate": "newData.isBoolean()"
          }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['authorId', 'authorName', 'text', 'timestamp'])",
            "authorId": {
              ".validate": "newData.isString()"
            },
            "authorName": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "timestamp": {
              ".validate": "newData.isString()"
            }
          }
        }
      }
    }
  }
}
